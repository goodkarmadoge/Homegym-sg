    "test:matcher": "node --test test/matcher.test.mjs test/sheet-parse.test.mjs",
    "sync": "node scripts/sync-sheet.mjs",
    "sync:check": "node scripts/sync-sheet.mjs --check",
    "sweep": "node scripts/sweep.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run test && npm run sweep && npm run build && npm run verify",
    "check:images": "node scripts/check-images.mjs",
    "check:fit": "node scripts/check-fit.mjs",
    "check:heroes": "node scripts/check-heroes.mjs"
  },
  "engines": {
    "node": ">=20"
  },
