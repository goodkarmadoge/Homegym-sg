{
  "name": "homegym-sg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pro bono site and business teardown of homegym.sg, with a positioning brief and a guided-selling prototype",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:quiz": "node scripts/build-quiz.mjs",
    "test": "npm run test:engine && npm run test:matcher",
